* { margin: 0; padding: 0; box-sizing: border-box; }
html, body {
  width: 100%; height: 100%; overflow: hidden; background: #0a0a1a;
  font-family: 'Segoe UI', 'Apple SD Gothic Neo', sans-serif;
  user-select: none; -webkit-user-select: none; touch-action: none;
}
#gc { display: block; width: 100%; height: 100%; }
.hidden { display: none !important; }

/* ── overlays ── */
.ov {
  position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.88); z-index: 100;
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  overflow-y: auto;
}
.ov-box {
  text-align: center; color: #fff; padding: 36px 28px; max-width: 560px; width: 92%;
}
.ov-box.wide-box { max-width: 720px; }

/* ── title ── */
.title {
  font-size: clamp(2.2rem, 9vw, 4.4rem); font-weight: 900;
  background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcb77, #4d96ff);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; letter-spacing: .04em; margin-bottom: 4px;
  animation: titlePulse 3s ease-in-out infinite;
}
@keyframes titlePulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.3); } }
.subtitle { font-size: clamp(.7rem, 2vw, 1rem); letter-spacing: .55em; color: rgba(255,255,255,.35); margin-bottom: 20px; }
.tagline { font-size: clamp(1rem, 3vw, 1.3rem); color: rgba(255,255,255,.7); margin-bottom: 16px; }
.hint { font-size: .78rem; color: rgba(255,255,255,.35); margin-top: 18px; line-height: 1.6; }

/* ── screen titles ── */
.screen-title { font-size: 1.6rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
.screen-subtitle { font-size: .85rem; color: rgba(255,255,255,.5); margin-bottom: 20px; }

/* ── buttons ── */
.btn {
  display: inline-block; padding: 14px 48px; border: none; border-radius: 12px;
  font-size: 1.1rem; font-weight: 700; cursor: pointer; color: #fff;
  transition: transform .15s, box-shadow .15s;
}
.btn-primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 4px 24px rgba(99,102,241,.4);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 32px rgba(99,102,241,.55); }
.btn-primary:active { transform: translateY(0); }
.btn-secondary {
  background: rgba(255,255,255,.08); border: 1.5px solid rgba(255,255,255,.15);
  padding: 10px 24px; font-size: .95rem;
}
.btn-secondary:hover { background: rgba(255,255,255,.15); transform: translateY(-1px); }
.btn-secondary:active { transform: translateY(0); }

.menu-btns { display: flex; gap: 12px; justify-content: center; margin-top: 16px; flex-wrap: wrap; }
.end-btns { display: flex; gap: 12px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }

/* ── menu gold ── */
.menu-gold {
  font-size: 1rem; font-weight: 700; color: #ffd93d; margin-bottom: 20px;
  text-shadow: 0 0 12px rgba(255,217,61,.3);
}

/* ── best record ── */
.best-record {
  font-size: .82rem; color: rgba(255,217,61,.6); margin-bottom: 8px;
  font-variant-numeric: tabular-nums; letter-spacing: .03em;
}
.new-record {
  font-size: 1.1rem; font-weight: 800; color: #ffd93d; margin-bottom: 12px;
  text-shadow: 0 0 20px rgba(255,217,61,.5); animation: recordPulse 1s ease-in-out infinite;
}
@keyframes recordPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }

/* ── CHARACTER SELECT ── */
.char-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 12px; margin-bottom: 20px;
}
.char-card {
  padding: 16px 12px; border-radius: 14px;
  background: rgba(255,255,255,.05); border: 2px solid rgba(255,255,255,.1);
  cursor: pointer; transition: transform .15s, border-color .2s, background .2s;
  text-align: center;
}
.char-card:hover { transform: translateY(-3px); border-color: #6366f1; background: rgba(99,102,241,.12); }
.char-card:active { transform: translateY(0); }
.char-card.selected { border-color: #ffd93d; background: rgba(255,217,61,.08); box-shadow: 0 0 20px rgba(255,217,61,.15); }
.char-card.locked {
  opacity: .5; cursor: not-allowed; border-color: rgba(255,255,255,.05);
}
.char-card.locked:hover { transform: none; border-color: rgba(255,255,255,.05); background: rgba(255,255,255,.05); }
.char-icon { font-size: 2rem; margin-bottom: 6px; }
.char-name { font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.char-desc { font-size: .72rem; color: rgba(255,255,255,.55); margin-bottom: 6px; line-height: 1.4; }
.char-stats { font-size: .68rem; color: rgba(255,255,255,.4); }
.char-stats span { display: inline-block; margin: 0 4px; }

/* ── PET SELECT ── */
.pet-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 12px; margin-bottom: 20px; max-height: 50vh; overflow-y: auto;
  padding: 10px;
}
.pet-card {
  background: rgba(255,255,255,.05); border: 1.5px solid rgba(255,255,255,.1);
  border-radius: 12px; padding: 14px 10px; text-align: center;
  transition: all .2s; cursor: pointer;
}
.pet-card:hover { transform: translateY(-3px); border-color: #6366f1; background: rgba(99,102,241,.12); }
.pet-card:active { transform: translateY(0); }
.pet-card.selected { border-color: #ffd93d; background: rgba(255,217,61,.08); box-shadow: 0 0 20px rgba(255,217,61,.15); }
.pet-icon { font-size: 2.5rem; margin-bottom: 6px; }
.pet-name { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.pet-desc { font-size: .68rem; color: rgba(255,255,255,.55); line-height: 1.4; }
.pet-btns { display: flex; justify-content: center; gap: 12px; margin-top: 10px; }

/* ── SHOP ── */
.shop-gold-display {
  font-size: 1.2rem; font-weight: 800; color: #ffd93d; margin-bottom: 8px;
  text-shadow: 0 0 12px rgba(255,217,61,.4);
}
.shop-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 10px; margin-bottom: 20px; max-height: 55vh; overflow-y: auto;
  padding-right: 4px;
}
.shop-card {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px; border-radius: 12px;
  background: rgba(255,255,255,.04); border: 1.5px solid rgba(255,255,255,.08);
  transition: transform .12s, border-color .2s, background .2s;
  text-align: left;
}
.shop-card.buyable { cursor: pointer; border-color: rgba(99,102,241,.3); }
.shop-card.buyable:hover { transform: translateY(-2px); border-color: #6366f1; background: rgba(99,102,241,.1); }
.shop-card.maxed { opacity: .5; }
.shop-icon { font-size: 1.5rem; flex-shrink: 0; }
.shop-info { flex: 1; min-width: 0; }
.shop-name { font-size: .85rem; font-weight: 700; color: #fff; margin-bottom: 2px; }
.shop-desc { font-size: .72rem; color: rgba(255,255,255,.5); margin-bottom: 4px; }
.shop-lv-bar { display: flex; gap: 3px; }
.shop-pip {
  width: 14px; height: 4px; border-radius: 2px;
  background: rgba(255,255,255,.12);
}
.shop-pip.filled { background: #6366f1; }
.shop-cost {
  font-size: .82rem; font-weight: 700; color: #ffd93d; white-space: nowrap; flex-shrink: 0;
}

/* ── ACHIEVEMENTS ── */
.achievement-progress {
  font-size: 1.1rem; margin-bottom: 16px; color: #ffd700;
}
.achievement-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 10px; margin-bottom: 20px; max-height: 55vh; overflow-y: auto;
  padding-right: 4px;
}
.achievement-card {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px; border-radius: 12px;
  background: rgba(255,255,255,.04); border: 1.5px solid rgba(255,255,255,.08);
  text-align: left;
}
.achievement-card.earned {
  border-color: rgba(255,215,0,.3); background: rgba(255,215,0,.08);
}
.achievement-icon { font-size: 1.8rem; flex-shrink: 0; }
.achievement-info { flex: 1; min-width: 0; }
.achievement-name { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 2px; }
.achievement-desc { font-size: .72rem; color: rgba(255,255,255,.5); margin-bottom: 4px; }
.achievement-reward { font-size: .72rem; color: #ffd93d; }
.achievement-status { font-size: 1.2rem; flex-shrink: 0; }

/* ── DAILY CHALLENGE ── */
.daily-challenge {
  background: linear-gradient(135deg, rgba(255,107,107,.15), rgba(255,152,0,.15));
  border: 2px solid rgba(255,152,0,.4);
  border-radius: 16px;
  padding: 20px;
  margin: 16px 0;
}
.daily-challenge-name { font-size: 1.4rem; font-weight: 800; color: #ff9800; margin-bottom: 8px; }
.daily-challenge-desc { font-size: 1rem; color: rgba(255,255,255,.8); margin-bottom: 12px; }
.daily-challenge-timer { font-size: .85rem; color: rgba(255,255,255,.5); }
.daily-best {
  font-size: .9rem; color: #4fc3f7;
  margin-bottom: 16px;
}
.daily-completed {
  font-size: 1rem; color: #4caf50; font-weight: 700;
  margin-bottom: 12px;
}

/* ── LEADERBOARD ── */
.leaderboard-tabs {
  display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; justify-content: center;
}
.tab-btn {
  padding: 8px 16px; border: none; border-radius: 8px;
  background: rgba(255,255,255,.08); color: rgba(255,255,255,.7);
  font-size: .85rem; cursor: pointer; transition: all .2s;
}
.tab-btn.active {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}
.tab-btn:hover:not(.active) {
  background: rgba(255,255,255,.15);
}
.leaderboard-list {
  max-height: 50vh; overflow-y: auto; margin-bottom: 16px;
}
.leaderboard-entry {
  display: flex; align-items: center; gap: 12px;
  padding: 12px; border-radius: 10px;
  background: rgba(255,255,255,.04); margin-bottom: 8px;
}
.leaderboard-rank {
  font-size: 1.2rem; font-weight: 800; min-width: 30px;
}
.leaderboard-rank.gold { color: #ffd700; }
.leaderboard-rank.silver { color: #c0c0c0; }
.leaderboard-rank.bronze { color: #cd7f32; }
.leaderboard-info { flex: 1; }
.leaderboard-name { font-size: .9rem; color: #fff; font-weight: 600; }
.leaderboard-stats { font-size: .75rem; color: rgba(255,255,255,.5); }
.leaderboard-score { font-size: 1rem; color: #ffd93d; font-weight: 700; }
.leaderboard-loading { text-align: center; color: rgba(255,255,255,.5); padding: 20px; }

/* ── STAGE SELECTION ── */
.stage-total-stars {
  font-size: 1.4rem; font-weight: 800; color: #ffd93d;
  text-align: center; margin-bottom: 16px;
  text-shadow: 0 0 10px rgba(255,217,61,.4);
}
.chapter-tabs {
  display: flex; gap: 8px; justify-content: center; margin-bottom: 16px; flex-wrap: wrap;
}
.chapter-tab {
  padding: 10px 20px; border: none; border-radius: 10px;
  background: rgba(255,255,255,.08); color: rgba(255,255,255,.7);
  font-size: .95rem; cursor: pointer; transition: all .2s;
}
.chapter-tab.active {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}
.chapter-tab:hover:not(.active) { background: rgba(255,255,255,.15); }
.chapter-tab:disabled { opacity: .4; cursor: not-allowed; }
.stage-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px; margin-bottom: 20px; max-height: 55vh; overflow-y: auto;
}
.stage-card {
  display: flex; align-items: center; gap: 12px;
  padding: 14px; border-radius: 12px;
  background: rgba(255,255,255,.05); border: 2px solid rgba(255,255,255,.1);
  cursor: pointer; transition: all .2s; text-align: left;
}
.stage-card:hover:not(.locked) {
  transform: translateY(-2px); border-color: #6366f1; background: rgba(99,102,241,.1);
}
.stage-card.locked { opacity: .5; cursor: not-allowed; }
.stage-icon { font-size: 2.5rem; }
.stage-info { flex: 1; }
.stage-name { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.stage-desc { font-size: .75rem; color: rgba(255,255,255,.5); margin-bottom: 4px; }
.stage-difficulty { font-size: .7rem; padding: 2px 6px; border-radius: 4px; }
.stage-difficulty.easy { background: rgba(76,175,80,.3); color: #81c784; }
.stage-difficulty.normal { background: rgba(255,193,7,.3); color: #ffd54f; }
.stage-difficulty.hard { background: rgba(244,67,54,.3); color: #ef5350; }
.stage-difficulty.nightmare { background: rgba(156,39,176,.3); color: #ba68c8; }
.stage-stars { font-size: 1.1rem; margin-left: auto; }
.stage-stars .filled { color: #ffd93d; }
.stage-stars .empty { color: rgba(255,255,255,.2); }

/* ── STAGE CLEAR ── */
.stage-clear-title {
  font-size: 2rem; font-weight: 800; color: #4caf50; margin-bottom: 20px;
  text-shadow: 0 0 20px rgba(76,175,80,.5);
}
.stage-clear-stars {
  font-size: 2.5rem; text-align: center; margin-bottom: 20px; letter-spacing: 8px;
}
.stage-clear-stats {
  text-align: center; margin-bottom: 24px; color: rgba(255,255,255,.8);
}
.stage-clear-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ── GACHA ── */
.gacha-currency {
  display: flex; justify-content: center; gap: 20px; margin-bottom: 16px;
  font-size: 1rem; color: #ffd93d;
}
.gacha-buttons {
  display: flex; gap: 12px; justify-content: center; margin-bottom: 16px;
}
.gacha-result {
  margin: 16px 0; padding: 16px; background: rgba(0,0,0,.5); border-radius: 12px;
}
.pulled-ghosts {
  display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
}
.pulled-ghost {
  display: flex; flex-direction: column; align-items: center; padding: 10px;
  border-radius: 10px; min-width: 80px;
  animation: pullAnimation 0.5s ease-out;
}
@keyframes pullAnimation {
  0% { transform: scale(0) rotate(-180deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.pulled-ghost.N { background: rgba(160,160,160,.3); border: 2px solid #a0a0a0; }
.pulled-ghost.R { background: rgba(79,195,247,.3); border: 2px solid #4fc3f7; }
.pulled-ghost.SR { background: rgba(171,71,188,.3); border: 2px solid #ab47bc; }
.pulled-ghost.SSR { background: rgba(255,152,0,.3); border: 2px solid #ff9800; }
.pulled-ghost.UR { background: rgba(255,23,68,.3); border: 2px solid #ff1744; }
.ghost-icon { font-size: 2rem; }
.ghost-name { font-size: .75rem; color: #fff; margin-top: 4px; text-align: center; }
.ghost-rarity { font-size: .65rem; color: rgba(255,255,255,.7); }
.ghost-inventory { margin-top: 20px; }
.ghost-inventory h3 { font-size: 1rem; color: #fff; margin-bottom: 10px; }
.ghost-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px;
  max-height: 200px; overflow-y: auto;
}
.ghost-item {
  display: flex; flex-direction: column; align-items: center; padding: 8px;
  background: rgba(255,255,255,.05); border-radius: 8px; font-size: .75rem;
}
.ghost-item .count { color: #ffd93d; font-weight: bold; }

/* ── SETTINGS ── */
.settings-content { text-align: left; max-width: 320px; margin: 0 auto 24px; }
.setting-row {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.06);
}
.setting-row label { font-size: .9rem; color: rgba(255,255,255,.7); min-width: 60px; }
.setting-row input[type="range"] {
  flex: 1; height: 4px; -webkit-appearance: none; appearance: none;
  background: rgba(255,255,255,.15); border-radius: 2px; outline: none;
}
.setting-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
  background: #6366f1; cursor: pointer;
}
.setting-row select {
  flex: 1; padding: 8px 12px; border-radius: 8px;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
  color: #fff; font-size: .9rem; outline: none; cursor: pointer;
}
.setting-row select option { background: #1a1a2e; color: #fff; }
.vol-val { font-size: .78rem; color: rgba(255,255,255,.5); min-width: 36px; text-align: right; }

/* ── level-up ── */
.lvl-title {
  font-size: 1.8rem; font-weight: 800; color: #ffd93d; margin-bottom: 20px;
  text-shadow: 0 0 20px rgba(255,217,61,.5);
}
#choices { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.choice-card {
  flex: 1; min-width: 140px; max-width: 200px; padding: 20px 14px;
  border-radius: 14px; background: rgba(255,255,255,.07); border: 2px solid rgba(255,255,255,.1);
  cursor: pointer; transition: transform .15s, border-color .2s, background .2s; text-align: center;
}
.choice-card:hover { transform: translateY(-4px); border-color: #6366f1; background: rgba(99,102,241,.15); }
.choice-card:active { transform: translateY(0); }
.choice-icon { font-size: 2rem; margin-bottom: 8px; }
.choice-name { font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.choice-lv { font-size: .72rem; color: rgba(255,255,255,.45); margin-bottom: 6px; }
.choice-desc { font-size: .78rem; color: rgba(255,255,255,.6); line-height: 1.4; }

/* synth card glow */
.choice-card.synth {
  border-color: #ffd93d; background: rgba(255,217,61,.08);
  box-shadow: 0 0 20px rgba(255,217,61,.15);
}
.choice-card.synth:hover { border-color: #ffab00; background: rgba(255,171,0,.15); }

/* ── HUD ── */
#hud { position: fixed; top: 0; left: 0; right: 0; z-index: 50; padding: 10px 16px; pointer-events: none; }
#hud-top { display: flex; flex-direction: column; gap: 5px; max-width: 320px; }
.bar-wrap { position: relative; height: 18px; border-radius: 9px; background: rgba(255,255,255,.1); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 9px; transition: width .25s ease; }
#hp-bar { background: linear-gradient(90deg, #ef5350, #e53935); width: 100%; }
#xp-bar { background: linear-gradient(90deg, #ffd54f, #ffb300); width: 0%; }
.bar-label {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: .68rem; font-weight: 700; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.6);
}
#hud-info { display: flex; gap: 12px; margin-top: 6px; flex-wrap: wrap; }
#hud-info span { font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.7); }
#hud-gold { color: #ffd93d; }
#diff-badge { font-size: .7rem; color: rgba(255,255,255,.4); }
#timer { font-variant-numeric: tabular-nums; }

/* ── combo display ── */
#combo-display {
  display: inline-flex; align-items: center; gap: 4px;
  color: #4caf50; font-weight: bold; font-size: .85rem;
  animation: comboPulse 0.3s ease-out;
}
#combo-display.hidden { display: none; }
#combo-count { font-size: 1.1em; }
#combo-tier { font-size: 1em; }

#combo-display.tier-5 { color: #4caf50; }
#combo-display.tier-10 { color: #ff5722; font-size: .9rem; }
#combo-display.tier-20 { color: #e040fb; font-size: .95rem; }
#combo-display.tier-50 { color: #ffd700; font-size: 1rem; text-shadow: 0 0 8px #ffd700; }

@keyframes comboPulse {
  0% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

#weapon-slots { display: flex; gap: 6px; margin-top: 8px; }
.wslot {
  width: 36px; height: 36px; border-radius: 8px; background: rgba(255,255,255,.08);
  border: 1.5px solid rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center;
  font-size: 1rem; position: relative;
}
.wslot-lv {
  position: absolute; bottom: -2px; right: -2px; font-size: .55rem; font-weight: 800;
  color: #ffd93d; background: rgba(0,0,0,.7); border-radius: 4px; padding: 0 3px;
}

/* ── end stats ── */
#end-stats { text-align: left; margin: 20px auto; max-width: 300px; }
.stat-row {
  display: flex; justify-content: space-between; padding: 6px 0;
  border-bottom: 1px solid rgba(255,255,255,.08); font-size: .85rem; color: rgba(255,255,255,.8);
}
.stat-row span:first-child { color: rgba(255,255,255,.5); }
.stat-row.gold-row { border-bottom: 2px solid rgba(255,217,61,.2); padding: 8px 0; }
#end-title { font-size: 1.8rem; font-weight: 800; margin-bottom: 8px; }
.gold-earned { font-size: 1rem; font-weight: 700; color: #ffd93d; margin-top: 8px; }

/* ── sound toggle ── */
.sound-btn {
  position: fixed; top: 12px; right: 16px; z-index: 55; width: 40px; height: 40px;
  border: none; border-radius: 10px; background: rgba(255,255,255,.1);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  font-size: 1.2rem; cursor: pointer; pointer-events: auto;
  color: #fff; display: flex; align-items: center; justify-content: center;
  transition: background .2s, transform .15s;
}
.sound-btn:hover { background: rgba(255,255,255,.2); transform: scale(1.1); }
.sound-btn:active { transform: scale(.95); }

/* ── volume panel ── */
.volume-panel {
  position: fixed; top: 60px; right: 16px; z-index: 55;
  background: rgba(0,0,0,.85); border-radius: 12px; padding: 12px;
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.1);
}
.vol-row {
  display: flex; align-items: center; gap: 8px; margin: 6px 0;
}
.vol-row span { font-size: 1rem; }
.vol-row input[type="range"] {
  width: 100px; height: 4px; -webkit-appearance: none; appearance: none;
  background: rgba(255,255,255,.2); border-radius: 2px; outline: none;
}
.vol-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%;
  background: #6366f1; cursor: pointer;
}

/* ── joystick ── */
#joy-zone { position: fixed; left: 0; bottom: 0; width: 50%; height: 50%; z-index: 60; }

/* ── scrollbar ── */
.shop-list::-webkit-scrollbar { width: 4px; }
.shop-list::-webkit-scrollbar-track { background: rgba(255,255,255,.05); border-radius: 2px; }
.shop-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 2px; }

/* ── responsive ── */
@media (max-width: 600px) {
  .ov-box { padding: 24px 16px; }
  .ov-box.wide-box { padding: 20px 12px; }
  .btn { padding: 12px 36px; font-size: 1rem; }
  #choices { flex-direction: column; align-items: center; }
  .choice-card { max-width: 280px; min-width: 0; width: 100%; }
  #hud-top { max-width: 200px; }
  .char-list { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
  .char-card { padding: 12px 8px; }
  .shop-list { grid-template-columns: 1fr; }
  .menu-btns { flex-direction: column; align-items: center; }
}
